{
  "name": "isl-sign-to-speech-platform",
  "version": "1.0.0",
  "description": "Production AI-Powered Indian Sign Language Sign-to-Speech Translator",
  "scripts": {
    "test:ai": "cd ai-service && python test_runner.py",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:all": "npm run test:backend && npm run test:frontend && npm run test:ai",
    "build:frontend": "cd frontend && npm run build",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run dev",
    "start:ai": "cd ai-service && uvicorn app.main:app --host 0.0.0.0 --port 8000"
  },
  "keywords": [
    "isl",
    "sign-language",
    "computer-vision",
    "speech-synthesis",
    "accessibility"
  ],
  "author": "",
  "license": "MIT"
}
